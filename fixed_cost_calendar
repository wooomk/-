<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="고정비 달력">
<meta name="theme-color" content="#1a1a2e">
<link rel="manifest" href="manifest.json">
<title>고정비 달력 — 나의 돈 흐름</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f5f5f7;--surface:#fff;--surface2:#f9f9fb;
  --border:#e8e8ec;--border-light:#f0f0f4;
  --text-primary:#1a1a2e;--text-secondary:#6b6b80;--text-muted:#b0b0c0;
  --income-bg:#fff5f5;--income-text:#d63031;
  --saving-bg:#f0fff4;--saving-text:#00864e;
  --expense-bg:#f0f4ff;--expense-text:#0052cc;
  --sub-bg:#f5f0ff;--sub-text:#6c3fc5;
  --weekend-bg:#fafafa;--today-bg:#fff9e6;--today-border:#f9ca24;
  --sat-text:#1a6ef7;--sun-text:#e74c3c;
  --shadow-sm:0 1px 3px rgba(0,0,0,.06);
  --shadow-md:0 4px 16px rgba(0,0,0,.08);
  --shadow-lg:0 8px 32px rgba(0,0,0,.12);
  --radius:16px;--mono:'DM Mono',monospace;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Pretendard',-apple-system,sans-serif;background:var(--bg);color:var(--text-primary);min-height:100vh;font-size:14px;}

/* ── TOP BAR ── */
.top-bar{position:sticky;top:0;z-index:200;background:rgba(255,255,255,.95);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:0 24px;height:60px;display:flex;align-items:center;justify-content:space-between;gap:12px;box-shadow:var(--shadow-sm);}
.top-bar h1{font-size:17px;font-weight:700;letter-spacing:-.5px;white-space:nowrap;flex-shrink:0;}
.top-bar h1 span{color:var(--expense-text);}
.tab-group{display:flex;gap:4px;background:var(--bg);border-radius:12px;padding:4px;flex-shrink:0;}
.tab-btn{font-family:'Pretendard',sans-serif;font-size:12px;font-weight:600;padding:6px 14px;border-radius:9px;border:none;cursor:pointer;background:transparent;color:var(--text-secondary);transition:all .15s;white-space:nowrap;}
.tab-btn.active{background:#fff;color:var(--text-primary);box-shadow:var(--shadow-sm);}
.top-bar-actions{display:flex;gap:8px;align-items:center;flex-shrink:0;}
.btn{font-family:'Pretendard',sans-serif;font-size:13px;font-weight:600;padding:7px 15px;border-radius:10px;border:none;cursor:pointer;transition:all .15s;white-space:nowrap;}
.btn-primary{background:var(--text-primary);color:#fff;}
.btn-primary:hover{background:#2d2d4a;transform:translateY(-1px);box-shadow:var(--shadow-md);}
.btn-secondary{background:var(--border-light);color:var(--text-secondary);border:1px solid var(--border);}
.btn-secondary:hover{background:var(--border);}

/* ── LAYOUT ── */
.layout{display:flex;min-height:calc(100vh - 60px);}
.main-area{flex:1;min-width:0;padding:20px 16px 20px 24px;display:flex;flex-direction:column;}
.view-panel{display:none;}
.view-panel.active{display:flex;flex-direction:column;flex:1;}

/* ── TIMELINE ── */
.calendar-wrapper{background:var(--surface);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden;border:1px solid var(--border);flex:1;}
.cal-table-container{overflow:auto;max-height:calc(100vh - 130px);}
.cal-table{width:100%;border-collapse:collapse;min-width:760px;}
.cal-table thead{position:sticky;top:0;z-index:50;background:var(--text-primary);}
.cal-table thead th{padding:12px 12px;font-size:11px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:rgba(255,255,255,.7);border-right:1px solid rgba(255,255,255,.08);white-space:nowrap;text-align:left;}
.cal-table thead th:last-child{border-right:none;}
.col-date{width:105px;}.col-day{width:38px;}.col-type{width:68px;}.col-sub{width:68px;}.col-name{min-width:150px;}.col-amount{width:135px;text-align:right!important;}.col-memo{min-width:130px;}
.cal-table tbody tr{border-bottom:1px solid var(--border-light);transition:background .1s;}
.cal-table tbody tr:hover{filter:brightness(.97);}
.cal-table tbody td{padding:9px 12px;vertical-align:middle;font-size:13px;}
.date-cell{white-space:nowrap;}
.date-year{font-size:10px;color:var(--text-muted);font-family:var(--mono);display:block;line-height:1;}
.date-main{font-size:13px;font-weight:600;font-family:var(--mono);}
.date-sat{color:var(--sat-text)!important;}.date-sun{color:var(--sun-text)!important;}
.day-badge{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;font-size:11px;font-weight:600;}
.day-sat .day-badge{background:#dbeafe;color:var(--sat-text);}
.day-sun .day-badge,.day-hol .day-badge{background:#fee2e2;color:var(--sun-text);}
.day-week .day-badge{background:var(--border-light);color:var(--text-secondary);}
.today-row .day-badge{background:var(--today-border)!important;color:#fff!important;box-shadow:0 2px 6px rgba(249,202,36,.4);}
.type-badge{display:inline-flex;align-items:center;justify-content:center;padding:2px 8px;border-radius:20px;font-size:10px;font-weight:700;white-space:nowrap;}
.badge-income{background:var(--income-bg);color:var(--income-text);}
.badge-saving{background:var(--saving-bg);color:var(--saving-text);}
.badge-expense{background:var(--expense-bg);color:var(--expense-text);}
.badge-subscription{background:var(--sub-bg);color:var(--sub-text);}
.row-income{background:var(--income-bg);}.row-saving{background:var(--saving-bg);}.row-expense{background:var(--expense-bg);}.row-subscription{background:var(--sub-bg);}
.row-weekend{background:var(--weekend-bg);}
.today-row{background:var(--today-bg)!important;border-left:3px solid var(--today-border);}
.row-empty{background:transparent!important;}.row-empty td{padding:7px 12px;}.row-empty:hover{filter:none!important;}
.month-sep td{padding:16px 12px 8px;font-size:15px;font-weight:700;background:var(--bg)!important;border-bottom:2px solid var(--border);}
.amount-cell{text-align:right;font-family:var(--mono);font-size:13px;cursor:pointer;border-radius:6px;transition:background .15s;padding:4px 8px!important;}
.amount-cell:hover{background:rgba(0,0,0,.04);}
.amount-predicted{color:var(--text-muted);font-style:italic;}
.amount-confirmed{font-weight:600;}
.amount-income{color:var(--income-text);}.amount-saving{color:var(--saving-text);}.amount-expense{color:var(--expense-text);}.amount-subscription{color:var(--sub-text);}
.amount-input{font-family:var(--mono);font-size:13px;font-weight:600;text-align:right;width:120px;border:2px solid var(--text-primary);border-radius:6px;padding:3px 8px;outline:none;background:#fff;}
.item-name{font-weight:500;}
.memo-cell{font-size:12px;color:var(--text-muted);cursor:pointer;}
.memo-input{font-family:'Pretendard',sans-serif;font-size:12px;width:100%;border:1px solid var(--border);border-radius:6px;padding:3px 8px;outline:none;background:#fff;}
.hol-name{font-size:9px;color:var(--sun-text);font-weight:600;display:block;margin-top:1px;}
.load-more-row td{padding:20px;text-align:center;}
.load-more-btn{font-family:'Pretendard',sans-serif;font-size:13px;font-weight:600;padding:10px 28px;border-radius:24px;border:1.5px solid var(--border);background:#fff;color:var(--text-secondary);cursor:pointer;transition:all .15s;}
.load-more-btn:hover{border-color:var(--text-primary);color:var(--text-primary);}

/* ── GRID CALENDAR ── */
.cal-grid-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
.cal-grid-nav h2{font-size:20px;font-weight:700;letter-spacing:-.5px;}
.nav-btns{display:flex;gap:8px;}
.nav-btn{font-family:'Pretendard',sans-serif;font-size:13px;font-weight:600;padding:7px 16px;border-radius:10px;border:1.5px solid var(--border);background:#fff;color:var(--text-secondary);cursor:pointer;transition:all .15s;}
.nav-btn:hover{border-color:var(--text-primary);color:var(--text-primary);}
.cal-grid-wrap{background:var(--surface);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);overflow:hidden;}
.cal-grid-header{display:grid;grid-template-columns:repeat(7,1fr);background:var(--text-primary);}
.cal-grid-header div{padding:10px 4px;text-align:center;font-size:12px;font-weight:700;letter-spacing:.5px;}
.gh-sun{color:#ff7675;}.gh-sat{color:#74b9ff;}.gh-week{color:rgba(255,255,255,.65);}
.cal-grid-body{display:grid;grid-template-columns:repeat(7,1fr);border-top:1px solid var(--border);}
.cal-day{min-height:110px;border-right:1px solid var(--border-light);border-bottom:1px solid var(--border-light);padding:8px 6px;transition:background .12s;overflow:hidden;}
.cal-day:hover{background:#f8f8fc;}
.cal-day:nth-child(7n){border-right:none;}
.cal-day.other-month{background:var(--bg);opacity:.5;}
.cal-day.is-today{background:var(--today-bg);}
.cal-day.is-today .cal-day-num-wrap{background:var(--today-border);border-radius:50%;width:26px;height:26px;display:flex;align-items:center;justify-content:center;}
.cal-day.is-today .cal-day-num{color:#fff!important;}
.cal-day-num{font-size:13px;font-weight:700;font-family:var(--mono);line-height:1;}
.cal-day-num-wrap{width:26px;height:26px;display:flex;align-items:center;justify-content:center;margin-bottom:2px;}
.cal-sat .cal-day-num{color:var(--sat-text);}
.cal-sun .cal-day-num,.cal-hol .cal-day-num{color:var(--sun-text);}
.hol-label{font-size:9px;color:var(--sun-text);font-weight:600;margin-bottom:3px;}
.cal-chip{font-size:10px;font-weight:600;padding:2px 5px;border-radius:4px;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;display:block;line-height:1.4;}
.chip-income{background:var(--income-bg);color:var(--income-text);}
.chip-saving{background:var(--saving-bg);color:var(--saving-text);}
.chip-expense{background:var(--expense-bg);color:var(--expense-text);}
.chip-subscription{background:var(--sub-bg);color:var(--sub-text);}
.chip-more{background:var(--border-light);color:var(--text-secondary);font-size:9px;}

/* ── ANNUAL VIEW ── */
.annual-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px;}
.annual-header h2{font-size:20px;font-weight:700;letter-spacing:-.5px;}
.year-nav{display:flex;align-items:center;gap:10px;}
.year-nav span{font-size:16px;font-weight:700;font-family:var(--mono);min-width:52px;text-align:center;}

/* Chart card */
.chart-card{background:var(--surface);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);padding:24px;margin-bottom:20px;}
.chart-title{font-size:14px;font-weight:700;color:var(--text-primary);margin-bottom:6px;}
.chart-subtitle{font-size:12px;color:var(--text-muted);margin-bottom:20px;}
.chart-legend{display:flex;gap:20px;margin-bottom:16px;flex-wrap:wrap;}
.chart-legend-item{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;}
.legend-line{width:24px;height:3px;border-radius:2px;}
.chart-container{position:relative;width:100%;}
canvas#annualChart{width:100%!important;max-width:100%;}

/* Annual table */
.annual-table-card{background:var(--surface);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);overflow:hidden;}
.annual-table-header{padding:16px 20px;background:var(--text-primary);color:#fff;display:flex;align-items:center;justify-content:space-between;}
.annual-table-header h3{font-size:14px;font-weight:700;}
.annual-table{width:100%;border-collapse:collapse;font-size:13px;}
.annual-table thead th{padding:10px 14px;background:var(--bg);color:var(--text-muted);font-weight:700;font-size:11px;letter-spacing:.5px;text-transform:uppercase;border-bottom:1px solid var(--border);text-align:left;white-space:nowrap;}
.annual-table thead th.num{text-align:right;}
.annual-table tbody tr{border-bottom:1px solid var(--border-light);transition:background .1s;}
.annual-table tbody tr:hover{background:var(--surface2);}
.annual-table tbody tr.total-row{background:var(--bg);font-weight:700;border-top:2px solid var(--border);}
.annual-table tbody td{padding:11px 14px;vertical-align:middle;}
.annual-table tbody td.num{text-align:right;font-family:var(--mono);font-size:13px;}
.month-badge{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:var(--border-light);font-size:12px;font-weight:700;font-family:var(--mono);}
.month-badge.is-current{background:var(--today-border);color:#fff;}
.bar-wrap{display:flex;align-items:center;gap:8px;}
.bar-bg{flex:1;height:6px;background:var(--border-light);border-radius:3px;overflow:hidden;min-width:60px;}
.bar-fill{height:100%;border-radius:3px;transition:width .4s ease;}

/* ── MASTER PANEL ── */
.master-panel{width:560px;flex-shrink:0;padding:20px 24px 20px 0;position:sticky;top:60px;height:calc(100vh - 60px);overflow-y:auto;}
.master-card{background:var(--surface);border-radius:var(--radius);box-shadow:var(--shadow-sm);border:1px solid var(--border);overflow:hidden;}
.master-header{padding:16px 20px;background:var(--text-primary);color:#fff;display:flex;align-items:center;justify-content:space-between;}
.master-header h2{font-size:14px;font-weight:700;}
.master-header p{font-size:11px;color:rgba(255,255,255,.55);margin-top:2px;}
.btn-add{font-family:'Pretendard',sans-serif;font-size:12px;font-weight:700;padding:6px 14px;border-radius:8px;border:none;cursor:pointer;background:rgba(255,255,255,.15);color:#fff;transition:background .15s;white-space:nowrap;}
.btn-add:hover{background:rgba(255,255,255,.28);}
.legend-bar{display:flex;gap:10px;padding:10px 18px;background:var(--bg);border-top:1px solid var(--border);flex-wrap:wrap;}
.legend-item{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text-secondary);}
.legend-dot{width:8px;height:8px;border-radius:50%;}
.master-scroll{overflow-x:auto;}
.master-table{width:100%;border-collapse:collapse;font-size:12px;min-width:620px;}
.master-table thead th{padding:8px 10px;background:var(--bg);color:var(--text-muted);font-weight:600;font-size:10px;letter-spacing:.6px;text-transform:uppercase;border-bottom:1px solid var(--border);white-space:nowrap;text-align:left;}
.master-table tbody tr{border-bottom:1px solid var(--border-light);transition:background .1s;}
.master-table tbody tr:hover{background:var(--surface2);}
.master-table tbody td{padding:7px 10px;vertical-align:middle;}
.master-input{font-family:'Pretendard',sans-serif;font-size:12px;width:100%;border:1.5px solid transparent;border-radius:6px;padding:4px 6px;background:transparent;color:var(--text-primary);transition:border-color .15s,background .15s;outline:none;}
.master-input:focus{border-color:var(--text-primary);background:#fff;box-shadow:0 0 0 3px rgba(26,26,46,.06);}
.master-select{font-family:'Pretendard',sans-serif;font-size:12px;width:100%;border:1.5px solid transparent;border-radius:6px;padding:4px 4px;background:transparent;color:var(--text-primary);cursor:pointer;outline:none;transition:border-color .15s;}
.master-select:focus{border-color:var(--text-primary);background:#fff;}
.btn-del{font-family:'Pretendard',sans-serif;font-size:10px;font-weight:700;padding:4px 8px;border-radius:6px;border:1px solid #ffd0d0;background:#fff5f5;color:var(--income-text);cursor:pointer;white-space:nowrap;transition:all .15s;}
.btn-del:hover{background:var(--income-text);color:#fff;border-color:var(--income-text);}

/* SUMMARY */
.summary-card{margin-top:12px;background:var(--surface);border-radius:var(--radius);box-shadow:var(--shadow-sm);border:1px solid var(--border);padding:16px 20px;}
.summary-title{font-size:12px;font-weight:700;color:var(--text-muted);letter-spacing:.5px;text-transform:uppercase;margin-bottom:12px;}
.summary-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border-light);}
.summary-row:last-child{border-bottom:none;}
.summary-label{font-size:13px;font-weight:500;color:var(--text-secondary);}
.summary-value{font-family:var(--mono);font-size:14px;font-weight:600;}
.val-income{color:var(--income-text);}.val-saving{color:var(--saving-text);}.val-expense{color:var(--expense-text);}.val-sub{color:var(--sub-text);}.val-net{color:var(--text-primary);}

::-webkit-scrollbar{width:6px;height:6px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px;}
::-webkit-scrollbar-thumb:hover{background:var(--text-muted);}
.toast{position:fixed;bottom:30px;right:30px;background:var(--text-primary);color:#fff;padding:12px 20px;border-radius:12px;font-size:13px;font-weight:600;box-shadow:var(--shadow-lg);transform:translateY(80px);opacity:0;transition:all .3s cubic-bezier(.34,1.56,.64,1);z-index:999;pointer-events:none;}
.toast.show{transform:translateY(0);opacity:1;}
@media(max-width:1200px){.master-panel{width:460px;}}
@media(max-width:900px){.master-panel{display:none;}.main-area{padding:12px;}}
</style>
</head>
<body>

<header class="top-bar">
  <h1>💸 고정비 <span>달력</span></h1>
  <div class="tab-group">
    <button class="tab-btn active" id="tabTimeline" onclick="switchTab('timeline')">📋 타임라인</button>
    <button class="tab-btn" id="tabGrid" onclick="switchTab('grid')">📅 달력</button>
    <button class="tab-btn" id="tabAnnual" onclick="switchTab('annual')">📊 연간분석</button>
  </div>
  <div class="top-bar-actions">
    <button class="btn btn-secondary" onclick="toggleMasterPanel()">⚙ 규칙 관리</button>
    <button class="btn btn-primary" id="todayBtn" onclick="goToToday()">오늘</button>
  </div>
</header>

<div class="layout">
  <div class="main-area">

    <!-- ① TIMELINE -->
    <div class="view-panel active" id="viewTimeline">
      <div class="calendar-wrapper">
        <div class="cal-table-container" id="calContainer">
          <table class="cal-table">
            <thead>
              <tr>
                <th class="col-date">날짜</th>
                <th class="col-day" style="text-align:center;">요일</th>
                <th class="col-type" style="text-align:center;">구분</th>
                <th class="col-sub" style="text-align:center;">소구분</th>
                <th class="col-name">내용</th>
                <th class="col-amount">금액 (원)</th>
                <th class="col-memo">메모</th>
              </tr>
            </thead>
            <tbody id="calBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ② GRID CALENDAR -->
    <div class="view-panel" id="viewGrid">
      <div class="cal-grid-nav">
        <h2 id="gridTitle">2026년 6월</h2>
        <div class="nav-btns">
          <button class="nav-btn" onclick="changeGridMonth(-1)">◀ 이전</button>
          <button class="nav-btn" onclick="goGridToday()">오늘</button>
          <button class="nav-btn" onclick="changeGridMonth(1)">다음 ▶</button>
        </div>
      </div>
      <div class="cal-grid-wrap">
        <div class="cal-grid-header">
          <div class="gh-sun">일</div><div class="gh-week">월</div><div class="gh-week">화</div>
          <div class="gh-week">수</div><div class="gh-week">목</div><div class="gh-week">금</div><div class="gh-sat">토</div>
        </div>
        <div class="cal-grid-body" id="calGridBody"></div>
      </div>
    </div>

    <!-- ③ ANNUAL ANALYSIS -->
    <div class="view-panel" id="viewAnnual">
      <div class="annual-header">
        <h2 id="annualTitle">2026년 연간 지출 분석</h2>
        <div class="year-nav">
          <button class="nav-btn" onclick="changeAnnualYear(-1)">◀</button>
          <span id="annualYearLabel">2026</span>
          <button class="nav-btn" onclick="changeAnnualYear(1)">▶</button>
        </div>
      </div>

      <!-- 꺾은선 그래프 -->
      <div class="chart-card">
        <div class="chart-title">월별 수입 / 지출+구독 / 저축 추이</div>
        <div class="chart-subtitle">예측치(점선) · 실제 입력값(실선) 기준</div>
        <div class="chart-legend">
          <div class="chart-legend-item"><div class="legend-line" style="background:#d63031"></div><span style="color:#d63031">수입</span></div>
          <div class="chart-legend-item"><div class="legend-line" style="background:#0052cc"></div><span style="color:#0052cc">지출+구독</span></div>
          <div class="chart-legend-item"><div class="legend-line" style="background:#00864e"></div><span style="color:#00864e">저축</span></div>
        </div>
        <div class="chart-container">
          <canvas id="annualChart" height="280"></canvas>
        </div>
      </div>

      <!-- 연간 테이블 -->
      <div class="annual-table-card">
        <div class="annual-table-header">
